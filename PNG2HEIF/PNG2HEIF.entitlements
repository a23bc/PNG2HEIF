<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 目标：能读写 /var/mobile/Media/PhotoData/Photos.sqlite，同时**保留 App 自己的数据容器**。
         容器必须留着：转换要往 FileManager.default.temporaryDirectory 写临时 PNG/HEIC，
         历史记录写在 Documents 里。上一版照抄了 PhotosDatabaseInspector 的
         container-required=false + no-container=true，那两个键会去掉数据容器，
         于是临时目录不存在 → 每次转换都失败（那个项目不用临时目录，所以它没暴露这个问题）。

         真正让数据库可达的是 com.apple.private.security.no-sandbox；
         绝对路径只读例外是它之外的兜底。 -->
    <key>platform-application</key><true/>
    <key>com.apple.private.security.no-sandbox</key><true/>
    <key>com.apple.private.security.sandbox</key><false/>
    <key>com.apple.private.security.storage.AppDataContainers</key><true/>
    <key>com.apple.private.security.storage.AppBundles</key><true/>
    <key>com.apple.private.security.storage.MobileDocuments</key><true/>
    <key>com.apple.private.MobileContainerManager.allowed</key><true/>
    <key>com.apple.private.coreservices.canmaplsdatabase</key><true/>
    <key>com.apple.security.exception.files.absolute-path.read-only</key>
    <array>
        <string>/</string>
        <string>/private/</string>
        <string>/tmp/</string>
        <string>/var/</string>
        <string>/var/mobile/</string>
        <string>/var/mobile/Media/</string>
        <string>/var/mobile/Media/PhotoData/</string>
    </array>
    <key>com.apple.security.exception.files.home-relative-path.read-only</key>
    <array><string>/</string></array>
</dict>
</plist>
